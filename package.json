{
  "name": "maximus-engenharia-local",
  "version": "3.2.2",
  "description": "Engenharia com servidores Nim, PAT do GitHub pela interface, engenharia-data fixo, token Hugging Face local e Gemma 4 E2B",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "pairing:issue": "node scripts/issue-pairing-token.js",
    "devices:list": "node scripts/list-devices.js",
    "device:revoke": "node scripts/revoke-device.js",
    "audit:prod": "npm audit --omit=dev",
    "build:client": "vite build",
    "build": "npm run build:client",
    "dev:client": "vite --host 0.0.0.0",
    "start:legacy-node": "node server.js",
    "build:nim": "nim c -d:release --threads:on -o:dist/EngenhariaServer nim-server/src/engenharia_server.nim",
    "build:msi": "powershell -ExecutionPolicy Bypass -File windows/Build-Msi.ps1"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true,
    "dtrace-provider": false,
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "vite": "7.3.6"
  }
}
